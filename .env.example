DJANGO_SETTINGS_MODULE=config.settings

# App
DJANGO_SECRET_KEY=replace-with-a-local-secret
DEBUG=1

# Database (used by Docker Compose)
POSTGRES_DB=flood_db
POSTGRES_USER=flood_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cache / background jobs
REDIS_HOST=redis
REDIS_PORT=6379

# Object storage (used by Docker Compose)
MINIO_ROOT_USER=replace-with-a-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=flood-data

# Frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Weather provider credentials
ACCUWEATHER_API_KEY=
IMD_API_KEY=

# Optional trained Risk JSON artifact
RISK_JSON_MODEL_PATH=

# Optional live API integrations
# Never commit real credentials here. Put them in .env, which is git-ignored.
ZUPLO_CONSUMER_API_KEY=

# Set to true only when the application explicitly supports demo/offline mode.
# DEMO_MODE=true
